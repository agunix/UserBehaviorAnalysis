<!--
  AI-UBA Alert Loopback :: Manager Custom Rules
  =================================================
  This file should be added to the Wazuh MANAGER at /var/ossec/etc/rules/local_rules.xml.

  Note: Wazuh's built-in JSON decoder (when log_format=json) extracts fields
  automatically under `data.*`, so a custom decoder is NOT needed - a simple rule will suffice.

  To apply the changes, restart the manager:
    systemctl restart wazuh-manager

  For testing:
    /var/ossec/bin/wazuh-logtest
    (or) echo '{"source":"AI-UBA","severity":"high",...}' >> /var/ossec/logs/alerts/alerts.json
    Check the result in /var/ossec/logs/alerts/alerts.json.
-->
<group name="aiuba,user_behavior_analytics,">

  <!-- Base rule: identify all AI-UBA source events (does not generate alerts, only serves as a base) -->
  <rule id="100200" level="0">
    <field name="source">AI-UBA</field>
    <description>AI-UBA: user behavior anomaly event identified</description>
    <options>no_full_log</options>
  </rule>

  <!-- Low risk -->
  <rule id="100201" level="5">
    <if_sid>100200</if_sid>
    <field name="severity">low</field>
    <description>AI-UBA: Low risk behavior anomaly - $(data.rule_name) - user $(data.user)</description>
    <group>low_risk,</group>
  </rule>

  <!-- Medium risk -->
  <rule id="100202" level="8">
    <if_sid>100200</if_sid>
    <field name="severity">medium</field>
    <description>AI-UBA: Medium risk behavior anomaly - $(data.rule_name) - user $(data.user)</description>
    <group>medium_risk,</group>
  </rule>

  <!-- High risk -->
  <rule id="100203" level="12">
    <if_sid>100200</if_sid>
    <field name="severity">high</field>
    <description>AI-UBA: High risk behavior anomaly - $(data.rule_name) - user $(data.user)</description>
    <group>high_risk,gdpr_IV_35.7.d,</group>
  </rule>

  <!-- Critical risk (e.g., data exfiltration suspicion) -->
  <rule id="100204" level="15">
    <if_sid>100200</if_sid>
    <field name="severity">critical</field>
    <description>AI-UBA: Critical risk behavior anomaly - $(data.rule_name) - user $(data.user)</description>
    <group>critical_risk,gdpr_IV_35.7.d,</group>
  </rule>

</group>
