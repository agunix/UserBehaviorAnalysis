<!--
  UBA Alert Loopback :: Agent configuration
  ==================================================
  Add this block to the `ossec.conf` file of the Wazuh agent on the machine where UBA is running
(Windows: C:\Program Files (x86)\ossec-agent\ossec.conf,
Linux:   /var/ossec/etc/ossec.conf).

  The <location> path must be the SAME as the value of wazuh_alert_output.output_file in src/config/config.yaml.

  After adding this block, restart the agent:
    Windows: Restart-Service -Name WazuhSvc
    Linux:   systemctl restart wazuh-agent
-->
<ossec_config>
  <localfile>
    <log_format>json</log_format>
    <location>C:\UBA\data\uba_alerts\uba_events.json</location>
    <!-- Alternative for Linux: <location>/opt/UBA/data/uba_alerts/uba_events.json</location> -->
  </localfile>
</ossec_config>
