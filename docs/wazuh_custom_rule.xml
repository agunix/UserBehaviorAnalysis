<!--
  UBA Alert Loopback :: Manager Custom Rules
  =================================================
  Add this file to /var/ossec/etc/rules/local_rules.xml on the Wazuh MANAGER.

  Note: Wazuh's built-in JSON decoder (used with `log_format=json`) automatically
   extracts fields under `data.*`, so there is NO NEED to write a separate custom decoder — writing a rule directly is sufficient.

  After applying, restart the manager:
  systemctl restart wazuh-manager

  For test:
    /var/ossec/bin/wazuh-logtest
    (or) write '{"source":"UBA","severity":"high",...}' to a file and
    check the result in /var/ossec/logs/alerts/alerts.json.
-->
<group name="uba,user_behavior_analytics,">

  <!-- Base rule: recognize all events originating from UBA (does not create alerts itself; serves only as a foundation) -->
  <rule id="100200" level="0">
    <field name="source">UBA</field>
    <description>UBA: user behavior anomaly event received</description>
    <options>no_full_log</options>
  </rule>

  <!-- Low risk -->
  <rule id="100201" level="5">
    <if_sid>100200</if_sid>
    <field name="severity">low</field>
    <description>UBA: Low risk behavior anomaly - $(data.rule_name) - user $(data.user)</description>
    <group>low_risk,</group>
  </rule>

  <!-- Medium risk -->
  <rule id="100202" level="8">
    <if_sid>100200</if_sid>
    <field name="severity">medium</field>
    <description>UBA: Medium risk behavior anomaly - $(data.rule_name) - user $(data.user)</description>
    <group>medium_risk,</group>
  </rule>

  <!-- High risk -->
  <rule id="100203" level="12">
    <if_sid>100200</if_sid>
    <field name="severity">high</field>
    <description>UBA: High risk behavior anomaly - $(data.rule_name) - user $(data.user)</description>
    <group>high_risk,gdpr_IV_35.7.d,</group>
  </rule>

  <!-- Critical risk (e.g., data exfiltration suspicion) -->
  <rule id="100204" level="15">
    <if_sid>100200</if_sid>
    <field name="severity">critical</field>
    <description>UBA: Critical behavior anomaly - $(data.rule_name) - user $(data.user)</description>
    <group>critical_risk,gdpr_IV_35.7.d,</group>
  </rule>

</group>
