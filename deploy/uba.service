[Unit]
Description=AI-UBA (User Behavior Analytics) API and dashboard
Documentation=https://github.com/agunix/UserBehaviorAnalysis
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=uba
Group=uba
WorkingDirectory=/opt/uba
# Passwords are storred there (chmod 600, root-a məxsus) - NOT INCLUDED to the repo
EnvironmentFile=/etc/uba/uba.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/uba/venv/bin/python /opt/uba/main.py
Restart=on-failure
RestartSec=5

# Hardening (service only wirtes data/ and logs/ folders)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/uba/data /opt/uba/logs

[Install]
WantedBy=multi-user.target
