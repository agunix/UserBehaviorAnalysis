# UBA runtime configuration -> /etc/uba/uba.env (chmod 600, owner root)
# Format: AIUBA_<SECTION>__<KEY>=value   (see: src/config/config.py)

# --- Wazuh Indexer (OpenSearch) ---
AIUBA_WAZUH_INDEXER__HOST=127.0.0.1
AIUBA_WAZUH_INDEXER__PORT=9200
AIUBA_WAZUH_INDEXER__USERNAME=admin
AIUBA_WAZUH_INDEXER__PASSWORD=CHANGE_ME
AIUBA_WAZUH_INDEXER__VERIFY_SSL=false

# --- API / Dashboard ---
# 127.0.0.1 = only from this server (open via SSH tunnel or reverse proxy).
# To open to the network, write 0.0.0.0, MANDATORY to set the following password.
AIUBA_API__HOST=127.0.0.1
AIUBA_API__PORT=8088
AIUBA_API__BASIC_USER=admin
AIUBA_API__BASIC_PASSWORD=CHANGE_ME_TOO
